{
	"name": "ui-sdk-table-vue",
	"version": "0.1.0",
	"description": "Vue parts for the ui-sdk-table primitive: slots, v-model and controllers.",
	"keywords": [
		"data-grid",
		"headless",
		"table",
		"ui-sdk",
		"vue"
	],
	"homepage": "https://falldownthesystem.github.io/ui-sdk-table/",
	"bugs": {
		"url": "https://github.com/FallDownTheSystem/ui-sdk-table/issues"
	},
	"license": "MIT",
	"author": "FallDownTheSystem",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FallDownTheSystem/ui-sdk-table.git",
		"directory": "packages/vue"
	},
	"files": [
		"docs",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.perf.ts"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./export": "./src/export.ts",
		"./formulas": "./src/formulas.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack src/index.ts src/export.ts src/formulas.ts --platform neutral"
	},
	"dependencies": {
		"ui-sdk-table-core": "workspace:*"
	},
	"devDependencies": {
		"@types/jsdom": "catalog:",
		"@ui-sdk/core": "catalog:",
		"@ui-sdk/vue": "catalog:",
		"@vitejs/plugin-vue": "catalog:",
		"@vue/test-utils": "catalog:",
		"jsdom": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vue": "catalog:"
	},
	"peerDependencies": {
		"@ui-sdk/core": "0.1.0-beta.13",
		"@ui-sdk/vue": "0.1.0-beta.13",
		"vue": ">=3.5"
	}
}
