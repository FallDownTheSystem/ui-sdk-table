{
	"name": "ui-sdk-table-core",
	"version": "0.2.0",
	"description": "Framework-free table primitive, behaviors and row helpers built on @ui-sdk/core.",
	"keywords": [
		"data-grid",
		"headless",
		"table",
		"ui-sdk"
	],
	"homepage": "https://falldownthesystem.github.io/ui-sdk-table/",
	"bugs": {
		"url": "https://github.com/FallDownTheSystem/ui-sdk-table/issues"
	},
	"license": "MIT",
	"author": "FallDownTheSystem",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FallDownTheSystem/ui-sdk-table.git",
		"directory": "packages/core"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.perf.ts",
		"!src/sheet/harness.ts"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./export": "./src/export/index.ts",
		"./formulas": "./src/formulas/index.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack src/index.ts src/export/index.ts src/formulas/index.ts --platform neutral"
	},
	"devDependencies": {
		"@types/jsdom": "catalog:",
		"@ui-sdk/core": "catalog:",
		"jsdom": "catalog:",
		"ssf": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"@ui-sdk/core": "0.1.0-beta.13"
	}
}
