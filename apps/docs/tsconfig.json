{
	"extends": "@vue/tsconfig/tsconfig.dom.json",
	"include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue", "e2e/**/*.ts"],
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"noUncheckedIndexedAccess": true,
		// The styled table imports `cn` from the address that the consumer app has.
		"paths": {
			"@/lib/utils": ["../../packages/styled/src/lib/utils.ts"]
		},
		"tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.docs.tsbuildinfo"
	}
}
